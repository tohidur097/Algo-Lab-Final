#include <iostream> //prims
using namespace std;

int main()
{
    int n, e, a[10][10] = {0};
    int key[10], parent[10];
    bool mst[10] = {0};
    int total = 0;

    cout << "Enter number of vertices and edges: ";
    cin >> n >> e;

    cout << "Enter edges (u v weight):\n";

    for(int i=0; i<e; i++)
    {
        int u, v, w;
        cin >> u >> v >> w;
        a[u][v] = a[v][u] = w;
    }

    for(int i=1; i<=n; i++)
        key[i] = 9999, parent[i] = -1;

    key[1] = 0;

    for(int k=1; k<=n; k++)
    {
        int u = -1;

        for(int i=1; i<=n; i++)
            if(!mst[i] && (u==-1 || key[i]<key[u]))
                u=i;

        mst[u] = true;

        for(int v=1; v<=n; v++)
            if(a[u][v] && !mst[v] && a[u][v]<key[v])
                key[v]=a[u][v], parent[v]=u;
    }

    cout << "\nMinimum Spanning Tree:\n";

    for(int i=2; i<=n; i++)
    {
        cout << parent[i] << " - " << i << " = " << key[i] << endl;
        total += key[i];
    }

    cout << "Total = " << total << endl;

    return 0;
}
